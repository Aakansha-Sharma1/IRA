# IRA AI — Environment Configuration Example
# Copy this file to .env or pass through --dart-define during build

# Application Environment (development, staging, production)
APP_ENVIRONMENT=development

# Backend API Configuration
# Note: For Android Emulator use http://10.0.2.2:8000
# For physical device / local network use http://<your-machine-ip>:8000
API_BASE_URL=http://10.0.2.2:8000/api/v1

# Network Timeouts (milliseconds)
CONNECT_TIMEOUT=15000
RECEIVE_TIMEOUT=15000

# Logging Level (debug, info, warning, error)
LOG_LEVEL=debug
