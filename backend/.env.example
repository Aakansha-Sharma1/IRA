# IRA AI Backend Environment Configuration

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ira_db

# Security & JWT Tokens
JWT_SECRET_KEY=ira-development-secret-key-replace-in-production-min-32-chars-long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["*"]

# AI Companion (backend-only; never place these values in Flutter)
AI_PROVIDER=huggingface
HF_MODEL_ID=TinyLlama/TinyLlama-1.1B-Chat-v1.0
HF_TOKEN=
HF_MAX_NEW_TOKENS=256
HF_TEMPERATURE=0.7
HF_TOP_P=0.9
